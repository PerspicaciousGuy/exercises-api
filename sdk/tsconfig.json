{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["index.js", "src/**/*.js"],
  "exclude": ["node_modules", "**/*.d.ts"]
}
